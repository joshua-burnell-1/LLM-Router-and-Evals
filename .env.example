# Copy to .env and fill in. Never commit .env.
# Any provider whose key is set is called through LiteLLM (the real API).
# Claude models with no ANTHROPIC_API_KEY fall back to the local `claude` CLI (your Claude plan).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force one backend for every model (litellm | claude_code | mock)
ROUTEWISE_BACKEND=

# Optional: where eval results are stored
ROUTEWISE_DB=
